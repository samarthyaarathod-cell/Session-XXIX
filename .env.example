# For Gmail, use an App Password (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com

# Google OAuth 2.0 credentials from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Mailgun API (optional; signup uses Django SMTP when these are blank)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3

# Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_COUNTRY_CODE=+91

# Standalone Flask payment gateway sandbox demo
FLASK_SECRET_KEY=replace-with-a-long-random-local-secret
# Set to your public HTTPS tunnel origin for provider callbacks/redirects
PAYMENTS_PUBLIC_BASE_URL=https://your-public-https-tunnel.example
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_STAGING_BASE_URL=https://securegw-stage.paytm.in
STRIPE_SECRET_KEY=sk_test_replace-me
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google Maps Platform (enable Geocoding API and Maps Embed API)
GOOGLE_MAPS_API_KEY=
